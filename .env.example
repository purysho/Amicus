# Optional OpenAI-compatible model (local Ollama or hosted)
AMICUS_MODEL_BASE_URL=
AMICUS_MODEL=
AMICUS_MODEL_API_KEY=
PORT=4173

# Optional live public school calendar feeds. Exact HTTPS hostnames ONLY, comma separated.
# Texas Law (law.utexas.edu) is already allowlisted.
AMICUS_EVENT_FEED_HOSTS=

# Optional Google OAuth desktop/web client. Configure redirect URI:
# http://127.0.0.1:4173/api/google/callback
# Enable Gmail API and Calendar API in your OWN Google Cloud project.
# Never commit .env or any OAuth tokens.
AMICUS_GOOGLE_CLIENT_ID=
AMICUS_GOOGLE_CLIENT_SECRET=
